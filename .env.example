# Copy to .env and adjust. Never commit .env.

# Postgres from docker-compose.yml (local). In production (Vercel), use the pooled
# Neon/Vercel Postgres connection string instead — see docs/deployment-guide.md.
DATABASE_URL=postgres://devops:devops@localhost:5433/devops_learning

# Better Auth — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# SMTP for magic-link emails (Mailpit locally, UI at http://localhost:8025).
# In production, use an SMTP relay such as Resend — see docs/deployment-guide.md.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="DevOps Learning Space <no-reply@devops-learning.local>"

# Optional: GitHub OAuth (https://github.com/settings/developers → New OAuth App)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
